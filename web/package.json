{
  "name": "taiwan-water-pulse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
